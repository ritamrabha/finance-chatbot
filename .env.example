# Copy this file to .env and fill in values. .env is git-ignored - never commit it.
# Leave an Azure section blank to use the local fallback for that service.

# ---------- LLM (any OpenAI-compatible provider) ----------
# Groq:  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile  (or openai/gpt-oss-120b)
# xAI:   LLM_BASE_URL=https://api.x.ai/v1               LLM_MODEL=grok-4.3
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# ---------- App login ----------
# Generate the hash with:  python scripts/hash_password.py
APP_USERNAME=admin
APP_PASSWORD_HASH=

# ---------- Azure AI Document Intelligence ----------
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# ---------- Azure Blob Storage ----------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=invoices

# ---------- Database ----------
# Blank = local SQLite file (data/invoices.db).
# Azure SQL: two logins - a writer for the app, a READ-ONLY one for the chatbot.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_WRITER_USER=
AZURE_SQL_WRITER_PASSWORD=
AZURE_SQL_READER_USER=
AZURE_SQL_READER_PASSWORD=

# ---------- Monitoring ----------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---------- Optional: load secrets directly from Key Vault ----------
# (In App Service we use Key Vault references instead, so this is usually blank.)
KEY_VAULT_URL=
